{
  "name": "pentestkit-sdk-release-workspace",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "scripts": {
    "audit:repository": "node scripts/audit-repository.cjs",
    "build:package": "node scripts/prepare-npm-package.cjs",
    "test:npm": "node scripts/prepare-npm-package.cjs",
    "build:npm:release": "node scripts/prepare-npm-package.cjs --artifact-source automation-artifact --input-dir ../dist --publishable",
    "pack:dry-run": "npm --cache .release/npm/.npm-cache pack --dry-run --json .release/npm/pentestkit",
    "test:agents": "npm --prefix agents test",
    "test:smoke-helpers": "node --test scripts/framework-smoke-helpers.test.cjs",
    "test:package-contract": "node --test scripts/package-dependency-contract.test.cjs scripts/audit-repository.test.cjs",
    "test:ci": "npm run audit:repository && npm run test:smoke-helpers && npm run test:package-contract && npm run test:agents",
    "test:package": "node scripts/smoke-packed-package.cjs .release/npm",
    "test:release-package": "node scripts/prepare-npm-package.cjs",
    "preflight:release-frameworks": "node scripts/preflight-release-frameworks.cjs",
    "test:release-frameworks": "node scripts/test-release-frameworks.cjs",
    "test:provider-matrix": "node scripts/run-provider-release-matrix.cjs",
    "test:release": "npm run test:release-package && npm run test:release-frameworks -- --mode package"
  },
  "devDependencies": {
    "selenium-webdriver": "4.26.0"
  },
  "engines": {
    "node": ">=20"
  }
}
