{
  "version": "ptk-scenario-v2",
  "name": "OWASP Juice Shop authenticated setup",
  "description": "Minimal authentication setup used before authenticated crawl-only benchmark rows.",
  "personas": ["shopper"],
  "steps": [
    {
      "id": "login",
      "type": "auth",
      "persona": "shopper",
      "timeoutMs": 10000,
      "target": {
        "route": "/#/login"
      },
      "postAuthProbes": [
        "/rest/user/whoami",
        "/profile"
      ],
      "success": {
        "authState": "authenticated"
      }
    }
  ]
}
