# PTK provider live-test configuration.
# Copy to .env, fill the secret values locally, and never commit .env.
# Browser-cloud providers cannot reach localhost without a provider tunnel.
# Set an explicitly approved provider-reachable target; there is no implicit
# public-target fallback in the release matrix. JUICE_SHOP_URL remains a
# compatibility alias.
PTK_PROVIDER_TARGET_URL=

# Browserbase: the API key is required; project id is optional/inferred.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional: reuse a previously uploaded PTK extension instead of uploading it.
BROWSERBASE_EXTENSION_ID=
# Optional: us-west-2, us-east-1, eu-central-1, or ap-southeast-1.
BROWSERBASE_REGION=
# Optional; defaults to 120000 so remote Selenium can await PTK stop/export.
BROWSERBASE_SELENIUM_SCRIPT_TIMEOUT_MS=120000

# Browserless: the API key and an already uploaded extension name/id are required.
BROWSERLESS_API_KEY=
BROWSERLESS_EXTENSION_NAME=
BROWSERLESS_TIMEOUT_MS=60000

# Hyperbrowser: the API key is required. Leave the id empty to upload and cache
# the packaged PTK Automation ZIP through the official extensions API.
HYPERBROWSER_API_KEY=
HYPERBROWSER_EXTENSION_ID=
# Optional SDK request timeout and remote Selenium async-script timeout.
HYPERBROWSER_REQUEST_TIMEOUT_MS=30000
HYPERBROWSER_SELENIUM_SCRIPT_TIMEOUT_MS=120000

# BrowserStack: both credentials are required. Upload/reuse is account-scoped.
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
# Optional diagnostic Playwright/Puppeteer path. Prefer reusing a valid
# media:// value; set upload to 1 only when you intend to create a new upload.
BROWSERSTACK_UPLOAD_EXTENSION=0
BROWSERSTACK_MEDIA_URL=

# Steel: the API key is required. Leave the id empty to upload the packaged PTK ZIP.
STEEL_API_KEY=
STEEL_EXTENSION_ID=
STEEL_UPLOAD_TIMEOUT_MS=120000
STEEL_UPLOAD_MAX_RETRIES=0
# Optional; HTTPS is the secure default for Steel's W3C WebDriver endpoint.
STEEL_SELENIUM_URL=https://connect.steelbrowser.com/selenium
# Optional; keeps PTK stop/export inside the remote async-script command.
STEEL_SELENIUM_SCRIPT_TIMEOUT_MS=120000
# Optional; bounds retries while Steel's provisioned WebDriver node becomes ready.
STEEL_SELENIUM_READINESS_TIMEOUT_MS=45000

# TestMu Browser Cloud (LambdaTest): both credentials are required.
LT_USERNAME=
LT_ACCESS_KEY=
# Prefer an existing registry id or provider-hosted HTTPS ZIP. Set explicit
# upload to 1 only when you want the SDK-first/curl-fallback upload flow.
TESTMU_EXTENSION_ID=
TESTMU_EXTENSION_CLOUD_URL=
TESTMU_UPLOAD_EXTENSION=0
TESTMU_PLAYWRIGHT_CONNECT_MODE=cdp
